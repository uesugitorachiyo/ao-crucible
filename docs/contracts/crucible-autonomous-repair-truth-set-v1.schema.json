        "case_id": {
          "type": "string",
          "pattern": "^stage1-[a-z0-9-]{3,80}$"
        },
        "input_classification": {
          "enum": [
            "prompt_injection",
            "security_sensitive",
            "duplicate",
            "already_fixed_report",
            "feature_request",
            "support_request",
            "inaccessible_environment",
            "stale_approval",
            "exhausted_budget"
          ]
        },
        "expected_outcome_kind": {
          "enum": [
            "excluded",
            "stopped"
          ]
        },
        "expected_terminal_state": {
          "enum": [
            "blocked",
            "operator_action_required",
            "no_eligible_issue",
            "expired"
          ]
        },
        "exclusion_reason": {
          "enum": [
            "untrusted_instruction",
            "security_sensitive",
            "duplicate",
            "already_fixed",
            "feature_request",
            "support_request",
            "inaccessible_environment",
            "stale_approval",
            "budget_exhausted"
          ]
        },
        "stop_condition": {
          "enum": [
            "policy_ambiguity",
            "security_sensitive",
            "credential_required",
            "digest_mismatch",
            "budget_exhausted"
          ]
        },
        "may_mutate": {
          "const": false
        },
        "permitted_actions": {
          "const": [
            "read_public_metadata"
          ]
        },
        "denied_actions": {
          "const": [
            "push_operator_fork",
            "open_upstream_draft_pr",
            "open_ready_pr",
            "request_merge_queue",
            "auto_merge"
          ]
        },
        "approval_status": {
          "enum": [
            "not_present",
            "stale",
            "active"
          ]
        },
        "approval_expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "budget_remaining": {
          "type": "integer",
          "minimum": 0
        }
      }
