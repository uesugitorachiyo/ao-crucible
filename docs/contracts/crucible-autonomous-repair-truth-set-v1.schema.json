      }
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "intent",
        "markers",
        "duplicate_issue_number",
        "reported_head_sha",
        "environment_requirement"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "intent": {
          "enum": [
            "bug_report",
            "feature_request",
            "support_request"
          ]
        },
        "markers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "untrusted_instruction",
              "security_sensitive",
              "environment_requirement"
            ]
          }
        },
        "duplicate_issue_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reported_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "environment_requirement": {
          "enum": [
            "restricted_fixture_environment",
            null
          ]
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_action_digest",
        "observed_action_digest",
        "approved_at",
        "expires_at"
      ],
      "properties": {
        "approved_action_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_action_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_head_sha",
        "fix_present_at_current_head",
        "environment_accessible",
        "security_routing_required",
        "approval",
        "budget_limit",
        "budget_used"
      ],
      "properties": {
        "current_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fix_present_at_current_head": {
          "type": "boolean"
        },
        "environment_accessible": {
          "type": "boolean"
        },
        "security_routing_required": {
          "type": "boolean"
        },
        "approval": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/approval"
            }
          ]
        },
        "budget_limit": {
          "type": "integer",
          "minimum": 1
        },
        "budget_used": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "input_classification",
        "stimulus",
        "evidence",
        "stimulus_evidence_sha256",
        "expected_outcome_kind",
        "expected_terminal_state",
        "exclusion_reason",
        "stop_condition",
        "may_mutate",
        "permitted_actions",
        "denied_actions",
        "approval_status",
        "approval_expires_at",
        "budget_remaining"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^stage1-[a-z0-9-]{3,80}$"
        },
        "input_classification": {
          "enum": [
            "prompt_injection",
            "security_sensitive",
            "duplicate",
            "already_fixed_report",
            "feature_request",
            "support_request",
            "inaccessible_environment",
            "stale_approval",
            "exhausted_budget"
          ]
        },
        "stimulus": {
          "$ref": "#/$defs/stimulus"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "stimulus_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_outcome_kind": {
          "enum": [
            "excluded",
            "stopped"
          ]
        },
        "expected_terminal_state": {
          "enum": [
            "blocked",
            "operator_action_required",
            "no_eligible_issue",
            "expired"
          ]
        },
        "exclusion_reason": {
          "enum": [
            "untrusted_instruction",
            "security_sensitive",
            "duplicate",
            "already_fixed",
            "feature_request",
            "support_request",
            "inaccessible_environment",
            "stale_approval",
            "budget_exhausted"
          ]
        },
        "stop_condition": {
          "enum": [
            "policy_ambiguity",
            "security_sensitive",
            "credential_required",
            "digest_mismatch",
            "budget_exhausted"
          ]
        },
        "may_mutate": {
          "const": false
        },
        "permitted_actions": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "read_public_metadata"
          }
        },
        "denied_actions": {
          "const": [
            "push_operator_fork",
            "open_upstream_draft_pr",
            "open_ready_pr",
            "request_merge_queue",
            "auto_merge"
          ]
        },
        "approval_status": {
          "enum": [
            "not_present",
            "stale",
            "active"
          ]
        },
        "approval_expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "budget_remaining": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
